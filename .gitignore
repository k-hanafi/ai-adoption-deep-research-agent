# ═══════════════════════════════════════════════════════════════════════════
# AI-Enablement Deep Research Agent - Git Ignore
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Environment & Secrets
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.local
*.pem
*.key

# ─────────────────────────────────────────────────────────────────────────────
# Credentials folder (track templates, ignore actual keys)
# ─────────────────────────────────────────────────────────────────────────────
credentials/*.txt
!credentials/*.txt.template

# ─────────────────────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
*.egg-info/
dist/
build/
.eggs/

# ─────────────────────────────────────────────────────────────────────────────
# IDE
# ─────────────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ─────────────────────────────────────────────────────────────────────────────
# Output files (keep .gitkeep, ignore actual outputs)
# ─────────────────────────────────────────────────────────────────────────────
outputs/**/*.csv
outputs/**/*.json
outputs/**/*.jsonl
outputs/**/*.log
outputs/**/*.html
outputs/**/latest
!outputs/.gitkeep
!outputs/evals/runs/.gitkeep
# Paid Stage 2 runners and scoreboards stay in git. Per-company traces stay
# on disk only so clones do not carry hundreds of Agent JSON dumps.
!outputs/stage2/test_runs/**/*.py
!outputs/stage2/test_runs/**/summary.jsonl
logs/*.log
checkpoints/*.json
# Legacy presentation archive (superseded by evals/instances/)
presentation/eval_instances/catalog.json
presentation/eval_instances/index.html
!presentation/eval_instances/.gitkeep
# Standalone eval archive + run bundles (keep .gitkeep only)
evals/instances/**
!evals/instances/.gitkeep
evals/runs/**
!evals/runs/.gitkeep

# ─────────────────────────────────────────────────────────────────────────────
# OS
# ─────────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
