# ═══════════════════════════════════════════════════════════════════════════
# AI-Enablement Deep Research Agent - Git Ignore
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Environment & Secrets
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.local
*.pem
*.key

# ─────────────────────────────────────────────────────────────────────────────
# Credentials folder (track templates, ignore actual keys)
# ─────────────────────────────────────────────────────────────────────────────
credentials/*.txt
!credentials/*.txt.template

# ─────────────────────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
*.egg-info/
dist/
build/
.eggs/

# ─────────────────────────────────────────────────────────────────────────────
# IDE
# ─────────────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ─────────────────────────────────────────────────────────────────────────────
# Output files (keep .gitkeep, ignore actual outputs)
# ─────────────────────────────────────────────────────────────────────────────
outputs/**/*.csv
outputs/**/*.json
outputs/**/*.jsonl
outputs/**/*.log
outputs/**/*.html
outputs/**/latest
!outputs/.gitkeep
!outputs/evals/runs/.gitkeep
# Paid Stage 2 runners and scoreboards stay in git. Per-company traces stay
# on disk only so clones do not carry hundreds of Agent JSON dumps.
!outputs/stage2/test_runs/**/*.py
!outputs/stage2/test_runs/**/summary.jsonl
logs/*.log
checkpoints/*.json
# Legacy presentation archive (superseded by evals/instances/)
presentation/eval_instances/catalog.json
presentation/eval_instances/index.html
!presentation/eval_instances/.gitkeep
# Standalone eval archive + run bundles (keep .gitkeep only)
evals/instances/**
!evals/instances/.gitkeep
evals/runs/**
!evals/runs/.gitkeep
# Frozen March dump for panel rebuilds (~69MB). README says how to copy it.
evals/references/*.jsonl
evals/references/*.csv
!evals/references/.gitkeep
!evals/references/README.md
# March 2026 snapshot outputs (local only)
legacy_agent_march_2026/outputs/**
!legacy_agent_march_2026/outputs/.gitkeep
# Snapshot secrets + runtime files (its PROJECT_ROOT is this folder)
legacy_agent_march_2026/credentials/*.txt
!legacy_agent_march_2026/credentials/*.txt.template
legacy_agent_march_2026/logs/**
legacy_agent_march_2026/checkpoints/**
# Upcoming v2 production writes (PR2)
outputs/prod/**

# ─────────────────────────────────────────────────────────────────────────────
# OS
# ─────────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
